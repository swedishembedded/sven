# Sven Configuration
.sven.yaml
.auth.yaml

# Rust / Cargo
/target/
.cargo/
Cargo.lock

# samples/learning/ is a separate cargo workspace (see its README), so its
# build output lands here rather than in the root target/. It has to be
# ignored explicitly: `/target/` above is anchored at the repository root, and
# `make check/gates` scans untracked-but-unignored files, so an unignored
# nested target/ fails the machine-path gate with thousands of hits from
# generated build scripts.
/samples/learning/target/

# samples/agent/ is a second separate cargo workspace, same situation.
/samples/agent/target/
# ...but its .cargo/config.toml is tracked: it points the workspace's build
# at the root target/ (one build directory, artifact reuse), and `.cargo/`
# above would otherwise hide it.
!/samples/agent/.cargo/
/samples/agent/.cargo/registry/
/samples/agent/.cargo/git/

# Python cache
__pycache__

# Generated shell completions (produced by `make deb` / `make release`)
/target/completions/

# Debian packaging artefacts
/target/debian/
/target/debian-staging/

# Editor / IDE
.idea/
.vscode/
*.iml
*.swp
*.swo
*~

# Sven
/.sven/

# OS
.DS_Store
Thumbs.db

# Environment / secrets
.env
.env.*
*.key
*.pem

# Test artefacts
/tests/tmp/
*.bats.log

# Logs
*.log

# Site subproject
/site/node_modules/

# Local task notes (never part of repo history)
/.todo/
/site/dist/
/site/package-lock.json
/site/public/install

# Local runtime/IDE artefacts
.claude/
logs/
**/.sven/
*.token
# `git bundle` transfer artefacts (e.g. `sven.bundle`): a complete copy of
# this repo's own history, so committing one would embed the repo in itself.
*.bundle
credit.jsonl
credit.jsonl*
portal-devices.yaml

# Formal-model tooling (pinned third-party jar, fetched not committed)
/formal/tools/
