{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://swedishembedded.com/sven/schema/harness-workflow.schema.json",
  "$comment": "Copyright (c) 2026 Martin Schroder <info@swedishembedded.com>. SPDX-License-Identifier: Apache-2.0. Swedish Embedded AB implements editor-checkable, verifiable agent workflows for its clients. If your team needs expertise in declarative agent workflow languages then you can procure our services by sending an email to info@swedishembedded.com. Strictness: like the compiler's typed parser, this schema forbids unknown fields everywhere. Semantic rules (references, bounds, capabilities, template roots) remain the compiler's.",
  "title": "sven harness workflow (v2)",
  "description": "A sven declarative harness: an ordered workflow of tasks, the trusted gates that decide whether each task succeeded, and the success condition of the run. Lowered at compile time onto the v1 harness machinery.",
  "type": "object",
  "required": ["api_version", "name", "workflow"],
  "additionalProperties": false,
  "properties": {
    "api_version": {
      "const": "2",
      "description": "The language version of this schema."
    },
    "name": {
      "$ref": "#/$defs/identifier",
      "description": "The workflow's name, carried into the plan and the trace."
    },
    "description": {
      "type": "string",
      "description": "Human documentation for the workflow."
    },
    "inputs": {
      "type": "object",
      "description": "Typed inputs a run is started with, by name. Templates read them as {{ inputs.<name> }}.",
      "propertyNames": { "$ref": "#/$defs/identifier" },
      "additionalProperties": { "$ref": "#/$defs/io_value" }
    },
    "outputs": {
      "type": "object",
      "description": "Typed outputs the run returns on success, by name.",
      "propertyNames": { "$ref": "#/$defs/identifier" },
      "additionalProperties": { "$ref": "#/$defs/output" }
    },
    "agent": { "$ref": "#/$defs/agent" },
    "execution": { "$ref": "#/$defs/execution" },
    "capabilities": {
      "type": "array",
      "description": "The exact capabilities the workflow is granted. Omitted: derived from the agent profile and the gates, and printed by the compiler.",
      "items": { "$ref": "#/$defs/capability" },
      "uniqueItems": true
    },
    "gates": {
      "type": "object",
      "description": "Named trusted checks, referenced by tasks and by the success condition.",
      "propertyNames": { "$ref": "#/$defs/identifier" },
      "additionalProperties": { "$ref": "#/$defs/gate" }
    },
    "workflow": {
      "type": "array",
      "description": "The tasks, run in order.",
      "minItems": 1,
      "items": { "$ref": "#/$defs/task" }
    },
    "success": { "$ref": "#/$defs/success" },
    "on_failure": {
      "enum": ["fail", "return"],
      "description": "fail: a failed check ends the run as failed. return: it ends by returning the outputs with status failed and the failure."
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,47}$"
    },
    "io_type": { "enum": ["string", "number", "boolean", "json"] },
    "io_value": {
      "oneOf": [
        { "$ref": "#/$defs/io_type" },
        {
          "type": "object",
          "required": ["type"],
          "additionalProperties": false,
          "properties": {
            "type": { "$ref": "#/$defs/io_type" },
            "description": { "type": "string" }
          }
        }
      ]
    },
    "output": {
      "type": "object",
      "required": ["type", "value"],
      "additionalProperties": false,
      "properties": {
        "type": { "$ref": "#/$defs/io_type" },
        "value": { "description": "The output's value; strings are templates over inputs and task outputs." },
        "description": { "type": "string" }
      }
    },
    "capability": {
      "enum": [
        "ReadFile", "WriteFile", "DeleteFile", "ExecuteShell", "NetworkAccess",
        "GitOperation", "RunVerifier", "ControlDevice", "SpawnChild"
      ]
    },
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "profile": {
          "enum": ["none", "coding"],
          "description": "The tool profile the host must provide. none: the tools the host gives the session; coding: file inspection, editing, search and shell."
        },
        "instructions": {
          "type": "string",
          "description": "Standing instructions, prepended to every task prompt. A template over inputs."
        },
        "tools": {
          "type": "array",
          "description": "An explicit tool allowlist for every task; also enforced on proposed calls.",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "model": { "$ref": "#/$defs/identifier", "description": "The model role that answers: a name the host maps to a provider. Never an endpoint or a key." },
        "system": { "type": "string", "description": "The system message of the agent's conversation: a template over inputs, delivered as the model's system message." },
        "sampling": { "$ref": "#/$defs/sampling" },
        "thinking": { "$ref": "#/$defs/thinking" },
        "turn": { "$ref": "#/$defs/turn_bounds" }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "workspace": { "const": "repository", "description": "The host-provided workspace root." },
        "resume": { "const": true, "description": "Every run is checkpointable and resumable; false is not supported." },
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "steps": { "type": "integer", "minimum": 1 },
            "model_turns": { "type": "integer", "minimum": 1 },
            "tool_calls": { "oneOf": [{ "type": "integer", "minimum": 1 }, { "$ref": "#/$defs/input_hole" }], "description": "A number, or a single {{ inputs.<name> }} the host computes per run." },
            "delegate_depth": { "type": "integer", "minimum": 1 }
          },
          "anyOf": [
            { "required": ["steps"] },
            { "required": ["model_turns"] },
            { "required": ["tool_calls"] }
          ]
        }
      }
    },
    "metric_decl": {
      "type": "object",
      "required": ["file", "pointer", "type"],
      "additionalProperties": false,
      "properties": {
        "file": { "type": "string", "minLength": 1, "description": "Workspace-relative JSON file the gate's command writes." },
        "pointer": { "type": "string", "description": "RFC 6901 JSON pointer to the number." },
        "type": { "const": "number" }
      }
    },
    "gate": {
      "oneOf": [
        {
          "type": "object",
          "required": ["command"],
          "additionalProperties": false,
          "properties": {
            "description": { "type": "string" },
            "command": {
              "type": "array",
              "description": "The argv. Run without a shell; the exit status is authoritative.",
              "minItems": 1,
              "items": { "type": "string" }
            },
            "timeout": { "type": "integer", "minimum": 1, "maximum": 3600, "description": "Seconds. Default 600." },
            "cwd": { "type": "string", "description": "Workspace-relative working directory." },
            "stdin": { "type": "string", "description": "Text the command reads on standard input: a template over inputs and earlier task outputs, for what is too large for an argument." },
            "metrics": {
              "type": "object",
              "propertyNames": { "$ref": "#/$defs/identifier" },
              "additionalProperties": { "$ref": "#/$defs/metric_decl" }
            }
          }
        },
        { "$ref": "#/$defs/artifact_check" }
      ]
    },
    "artifact_check": {
      "type": "object",
      "required": ["artifact"],
      "additionalProperties": false,
      "properties": {
        "description": { "type": "string" },
        "artifact": { "type": "string", "minLength": 1, "description": "Workspace-relative path of a file that must exist." },
        "min_bytes": { "type": "integer", "minimum": 0 },
        "sha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" }
      }
    },
    "metric_ref": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]*\\.[a-z][a-z0-9_-]*$",
      "description": "<gate>.<metric>"
    },
    "threshold": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 1,
      "additionalProperties": false,
      "properties": {
        "eq": { "type": "number" },
        "ne": { "type": "number" },
        "gt": { "type": "number" },
        "gte": { "type": "number" },
        "lt": { "type": "number" },
        "lte": { "type": "number" }
      }
    },
    "metric_check": {
      "type": "object",
      "required": ["metric"],
      "additionalProperties": false,
      "properties": {
        "metric": { "$ref": "#/$defs/metric_ref" },
        "eq": { "type": "number" },
        "ne": { "type": "number" },
        "gt": { "type": "number" },
        "gte": { "type": "number" },
        "lt": { "type": "number" },
        "lte": { "type": "number" }
      }
    },
    "soft_check": {
      "type": "object",
      "required": ["gate", "required"],
      "additionalProperties": false,
      "properties": {
        "gate": { "$ref": "#/$defs/identifier" },
        "required": { "const": false, "description": "The gate's result is recorded (gates.<name>.*) and never repairs or fails the task." }
      }
    },
    "check": {
      "oneOf": [
        { "$ref": "#/$defs/identifier" },
        { "$ref": "#/$defs/artifact_check" },
        { "$ref": "#/$defs/metric_check" },
        { "$ref": "#/$defs/soft_check" }
      ]
    },
    "for_each": {
      "type": "object",
      "required": ["source"],
      "additionalProperties": false,
      "properties": {
        "source": {
          "oneOf": [
            {
              "type": "object",
              "required": ["json"],
              "additionalProperties": false,
              "properties": {
                "json": {
                  "type": "object",
                  "required": ["file", "pointer"],
                  "additionalProperties": false,
                  "properties": {
                    "file": { "type": "string", "minLength": 1, "description": "Workspace-relative JSON file, read once when the loop begins." },
                    "pointer": { "type": "string", "description": "RFC 6901 pointer to the array." }
                  }
                }
              }
            },
            {
              "type": "object",
              "required": ["input"],
              "additionalProperties": false,
              "properties": {
                "input": { "$ref": "#/$defs/identifier", "description": "A run input declared json." }
              }
            }
          ]
        },
        "id": { "type": "string", "minLength": 1, "description": "The item field that names an item; scalar items name themselves." },
        "max_items": { "type": "integer", "minimum": 1, "maximum": 10000, "description": "Default 500. A larger collection fails the run." }
      }
    },
    "until": {
      "type": "object",
      "required": ["metric", "max_iterations"],
      "additionalProperties": false,
      "properties": {
        "metric": { "$ref": "#/$defs/metric_ref" },
        "max_iterations": { "type": "integer", "minimum": 1, "maximum": 1000 },
        "eq": { "type": "number" },
        "ne": { "type": "number" },
        "gt": { "type": "number" },
        "gte": { "type": "number" },
        "lt": { "type": "number" },
        "lte": { "type": "number" }
      }
    },
    "input_hole": {
      "type": "string",
      "pattern": "^\\{\\{\\s*inputs\\.[a-z][a-z0-9_-]*\\s*\\}\\}$",
      "description": "A single {{ inputs.<name> }}, resolved when the turn starts."
    },
    "turn_bounds": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_output_tokens": { "oneOf": [{ "type": "integer", "minimum": 1 }, { "$ref": "#/$defs/input_hole" }] },
        "first_response_timeout": { "oneOf": [{ "type": "integer", "minimum": 1 }, { "$ref": "#/$defs/input_hole" }], "description": "Seconds to wait for the server's first response." }
      }
    },
    "sampling": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "temperature": { "oneOf": [{ "type": "number", "minimum": 0, "maximum": 2 }, { "$ref": "#/$defs/input_hole" }] },
        "top_p": { "oneOf": [{ "type": "number", "exclusiveMinimum": 0, "maximum": 1 }, { "$ref": "#/$defs/input_hole" }] },
        "top_k": { "oneOf": [{ "type": "integer", "minimum": 1 }, { "$ref": "#/$defs/input_hole" }] },
        "seed": { "oneOf": [{ "type": "integer", "minimum": 0 }, { "$ref": "#/$defs/input_hole" }], "description": "Never defaulted: a run is seeded only when the document says so." }
      }
    },
    "thinking": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "oneOf": [{ "type": "boolean" }, { "$ref": "#/$defs/input_hole" }], "description": "Reasoning on or off, on servers whose chat template has the switch." },
        "budget": { "oneOf": [{ "type": "integer", "minimum": 1 }, { "$ref": "#/$defs/input_hole" }], "description": "The most thinking tokens before a turn is cut off." }
      }
    },
    "corrections": {
      "type": "object",
      "required": ["max", "check", "author", "accept"],
      "additionalProperties": false,
      "properties": {
        "max": { "type": "integer", "minimum": 1, "maximum": 16 },
        "count": { "$ref": "#/$defs/input_hole", "description": "Lowers the most corrections for a run." },
        "check": { "$ref": "#/$defs/identifier", "description": "The command gate that judges the result before the first correction and after each." },
        "while": { "$ref": "#/$defs/condition", "description": "Earns a correction; default: the check did not pass." },
        "author": {
          "type": "object",
          "required": ["name", "task"],
          "additionalProperties": false,
          "properties": {
            "name": { "$ref": "#/$defs/identifier" },
            "model": { "$ref": "#/$defs/identifier" },
            "system": { "type": "string" },
            "task": { "type": "string", "minLength": 1 },
            "sampling": { "$ref": "#/$defs/sampling" },
            "thinking": { "$ref": "#/$defs/thinking" },
            "turn": { "$ref": "#/$defs/turn_bounds" }
          }
        },
        "accept": { "$ref": "#/$defs/identifier", "description": "The command gate that reads the author's message on standard input; exit 0 lets it be sent." },
        "retries": { "type": "integer", "minimum": 0, "maximum": 8 },
        "refusal": { "type": "string", "minLength": 1 },
        "allowance": { "oneOf": [{ "type": "integer", "minimum": 0 }, { "$ref": "#/$defs/input_hole" }] }
      }
    },
    "condition": {
      "description": "A path string, !path, or an {all|any|not|eq|ne} object over inputs and task outputs."
    },
    "task": {
      "type": "object",
      "required": ["name", "task"],
      "additionalProperties": false,
      "properties": {
        "name": { "$ref": "#/$defs/identifier" },
        "description": { "type": "string" },
        "task": { "type": "string", "minLength": 1, "description": "The prompt. A template over inputs and earlier task outputs." },
        "tools": {
          "type": "array",
          "description": "This task's tool allowlist; replaces the agent's.",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "when": { "$ref": "#/$defs/condition" },
        "model": { "$ref": "#/$defs/identifier", "description": "The model role that answers: a name the host maps to a provider. Never an endpoint or a key." },
        "system": { "type": "string", "description": "With model_only: the system message of the task's own conversation (a template)." },
        "allowance": { "oneOf": [{ "type": "integer", "minimum": 0 }, { "$ref": "#/$defs/input_hole" }], "description": "The tool calls the task's first turn may make; follow-ups and repairs draw on what is left. A call beyond it is refused and the turn ends with the stop tool_cap." },
        "max_repeated_results": { "type": "integer", "minimum": 1, "description": "End a turn with the stop repetition when the same call has been answered the same way this many times." },
        "model_only": { "type": "boolean", "description": "One model turn without tools (a planner or a supervisor); its answer is the task's output." },
        "schema": { "type": "object", "description": "With model_only: the JSON Schema the answer must satisfy; later tasks read its fields as tasks.<name>.output.<field>." },
        "sampling": { "$ref": "#/$defs/sampling" },
        "thinking": { "$ref": "#/$defs/thinking" },
        "turn": { "$ref": "#/$defs/turn_bounds" },
        "corrections": { "$ref": "#/$defs/corrections" },
        "for_each": { "$ref": "#/$defs/for_each" },
        "until": { "$ref": "#/$defs/until" },
        "follow_ups": {
          "type": "array",
          "description": "Further user turns in the same conversation, each sent only when its condition holds.",
          "items": {
            "type": "object",
            "required": ["task"],
            "additionalProperties": false,
            "properties": {
              "when": { "$ref": "#/$defs/condition" },
              "task": { "type": "string", "minLength": 1 },
              "max": { "type": "integer", "minimum": 1, "maximum": 8, "description": "Send the turn up to this many times, each only while its condition holds." },
              "allowance": { "oneOf": [{ "type": "integer", "minimum": 0 }, { "$ref": "#/$defs/input_hole" }], "description": "Sets the task's remaining tool calls for this turn." }
            }
          }
        },
        "outputs": {
          "type": "array",
          "description": "Workspace-relative files the task must produce; each is checked to exist before the task's gates run.",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "verify": {
          "type": "array",
          "description": "Checks that must pass, in order.",
          "items": { "$ref": "#/$defs/check" }
        },
        "repair": {
          "type": "object",
          "required": ["attempts"],
          "additionalProperties": false,
          "properties": {
            "attempts": { "type": "integer", "minimum": 1, "maximum": 16 },
            "prompt": {
              "type": "string",
              "minLength": 1,
              "description": "A template; {{ failure.gate }}, {{ failure.detail }}, {{ failure.exit_code }}, {{ failure.stdout }}, {{ failure.stderr }} and {{ failure.attempt }} describe the failure."
            }
          }
        }
      }
    },
    "success": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "gates": {
          "type": "array",
          "items": { "$ref": "#/$defs/identifier" }
        },
        "metrics": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/metric_ref" },
          "additionalProperties": { "$ref": "#/$defs/threshold" }
        },
        "work_items": {
          "type": "object",
          "required": ["all_completed"],
          "additionalProperties": false,
          "properties": { "all_completed": { "type": "boolean" } }
        }
      }
    }
  }
}
