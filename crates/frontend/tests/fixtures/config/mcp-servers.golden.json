        "timeout_secs": 30,
        "transport": {
          "headers": {},
          "type": "http",
          "url": "https://mcp.atlassian.com/v1/mcp"
        }
      },
      "github": {
        "enabled": false,
        "env": {
          "GITHUB_TOKEN": "example"
        },
        "oauth": null,
        "timeout_secs": 90,
        "transport": {
          "args": [
            "-y",
            "@modelcontextprotocol/server-github"
          ],
          "command": "npx",
          "type": "stdio"
        }
      },
      "linear": {
        "enabled": true,
        "env": {},
        "oauth": {},
