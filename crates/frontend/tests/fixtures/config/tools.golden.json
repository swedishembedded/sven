{
  "config": {
    "agent": {
      "child_run_timeout_secs": 3600,
      "compaction_keep_recent": 6,
      "compaction_overhead_reserve": 0.10000000149011612,
      "compaction_strategy": "structured",
      "compaction_threshold": 0.8500000238418579,
      "default_mode": "agent",
      "max_run_timeout_secs": 0,
      "max_step_timeout_secs": 0,
      "max_tool_rounds": 200,
      "system_prompt": null,
      "tool_result_token_cap": 4000
    },
    "mcp_servers": {},
    "model": {
      "api_key": null,
      "api_key_env": null,
      "aws_region": null,
      "azure_api_version": null,
      "azure_deployment": null,
      "azure_resource": null,
      "base_url": null,
      "cache_conversation": true,
      "cache_images": true,
      "cache_system_prompt": true,
      "cache_tool_results": true,
      "cache_tools": true,
      "driver_options": null,
      "extended_cache_time": false,
      "max_input_tokens": null,
      "max_output_tokens": null,
      "max_tokens": null,
      "mock_responses_file": null,
      "name": "openrouter/auto",
      "provider": "openrouter",
      "temperature": 0.20000000298023224
    },
    "providers": {},
    "tools": {
      "asr": {
        "bus_address": "unix:path=/run/brain/bus",
        "model": "brain/nemotronasr",
        "timeout_secs": 60
      },
      "auto_approve_patterns": [
        "cat *",
        "ls *",
        "rg *",
        "grep *",
        "cargo test*",
        "make check"
      ],
      "context": {
        "default_chunk_lines": 300,
        "max_parallel": 8,
        "sub_query_max_chars": 80000,
        "sub_query_timeout_secs": 120
      },
      "deny_patterns": [
        "rm -rf /*",
        "dd if=*",
        "curl * | sh"
      ],
      "disabled": [
        "web_search"
      ],
      "gdb": {
        "command_timeout_secs": 30,
        "connect_timeout_secs": 30,
        "gdb_path": "/usr/bin/gdb-multiarch",
        "server_startup_wait_ms": 1000
      },
      "lints": {
        "python_command": null,
        "rust_command": "cargo clippy --message-format json",
        "typescript_command": null
      },
      "memory": {
        "memory_file": "notes/memory.json"
      },
      "timeout_secs": 45,
      "web": {
        "fetch_max_chars": 50000,
        "search": {
          "api_key": "BSA-example"
        }
      }
    },
    "tui": {
      "ascii_borders": true,
      "code_line_numbers": false,
      "theme": "dark",
      "wrap_width": 100
    }
  },
  "warnings": []
